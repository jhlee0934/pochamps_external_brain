{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../server/src/*"],
      "@smogon/calc": ["./node_modules/@smogon/calc"]
    }
  },
  "include": ["src", "../server/src/calc", "../server/src/data", "../server/src/i18n.ts"]
}
